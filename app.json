{
  "expo": {
    "name": "Tronect",
    "slug": "tronect-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/light-LogoWithWord-h.png",
    "scheme": "tronectmobileapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.tronect.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/logo/icon/ios/ios-dark.png",
        "dark": "./assets/logo/icon/ios/ios-light.png",
        "tinted": "./assets/logo/icon/ios/ios-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "monochromeImage": "./assets/logo/icon/android/adaptive-icon.png",
        "foregroundImage": "./assets/logo/icon/android/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDuO4zmPxOA7ZXRtGdMslvcy_9Gn0Nzpc4"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "vn.tronect.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/icon/splash/splash-icon-dark.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/logo/icon/splash/splash-icon-light.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-media-library",
        {
          "photosPermission": "Cho phép Tronect lưu mã QR thanh toán vào thư viện ảnh.",
          "savePhotosPermission": "Cho phép Tronect lưu ảnh vào thiết bị của bạn."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enablePngCrunchInReleaseBuilds": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "861f16b4-44f7-45e5-9dde-4c723591d1c4"
      }
    }
  }
}